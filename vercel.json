{
  "redirects": [
    {
      "source": "/",
      "destination": "https://thiagowessley.com.br",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
